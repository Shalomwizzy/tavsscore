# Where the Laravel app lives (no trailing slash).
TAVS_BASE_URL=https://tavsscore.com

# The SHARED SECRET. This is NOT from SportyBet, 1xBet, or any provider.
# It is a random password YOU invent. Put the SAME value here and in the
# Laravel app's .env as BOOKING_WORKER_TOKEN. Generate one with:
#   openssl rand -hex 32
BOOKING_WORKER_TOKEN=replace-with-the-same-token-as-laravel

# Which platforms to build codes on (comma-separated). Start with sportybet.
PLATFORMS=sportybet

# Run the browser without a visible window (true on CI, false to watch locally).
HEADLESS=true
