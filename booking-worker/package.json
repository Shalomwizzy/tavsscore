{
  "name": "tavsscore-booking-worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "External Playwright worker that turns TavsScore's daily betslip spec into SportyBet / 1xBet booking codes and posts them back.",
  "scripts": {
    "start": "node src/index.js",
    "watch": "node src/watch.js",
    "capture": "node src/capture.js",
    "login-setup": "node src/login-setup.js",
    "capture-bet": "node src/capture-bet.js",
    "place-bet": "node src/place-bet.js",
    "postinstall": "playwright install chromium"
  },
  "dependencies": {
    "playwright": "^1.48.0"
  }
}
