            "icons": [{ "src": "/favicon.svg", "sizes": "any" }]
        },
        {
            "name": "Predictions",
            "short_name": "Tips",
            "url": "/predictions",
            "icons": [{ "src": "/favicon.svg", "sizes": "any" }]
        }
    ],
    "categories": ["sports", "news"],
    "lang": "en",
    "serviceworker": {
        "src": "/sw.js",
        "scope": "/"
    }
}
